            "type": "string",
            "maxLength": 20,
            "nullable": true
          },
          "priority": {
            "type": "string",
            "maxLength": 2,
            "nullable": true
          },
          "assignedTeam": {
            "type": "string",
            "maxLength": 100,
            "nullable": true
          },
          "targetDate": {
            "type": "string",
            "format": "date",
            "example": "2017-04-13",
            "nullable": true
          },
          "status": {
            "type": "string",
            "maxLength": 20,
            "nullable": true
          },
          "note": {
            "type": "string",
            "nullable": true
          },
          "created": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "FacilityService.EquipmentResult": {
        "title": "EquipmentResult",
        "type": "object",
        "properties": {
          "ID": {
            "type": "string",
            "maxLength": 20,
            "nullable": true
          },
          "name": {
